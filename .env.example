# Backend (.env in repository root)
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/terravelis
JWT_SECRET=replace-with-a-strong-random-secret
# Comma-separated frontend origins allowed by CORS & Socket.io (leave unset to allow all during setup)
ORIGIN=http://localhost:5173,https://terravelis.vercel.app

# Frontend (Vercel Environment Variables)
# Set VITE_API_BASE_URL on Vercel to your Render backend URL (no trailing slash):
# VITE_API_BASE_URL=https://terravelis.onrender.com
