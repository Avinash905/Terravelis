# Backend (.env in repository root)
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatterbox
JWT_SECRET=replace-with-a-strong-random-secret
# Comma-separated frontend origins allowed by CORS & Socket.io (leave unset to allow all during setup)
ORIGIN=http://localhost:5173,https://your-vercel-domain.vercel.app

# Frontend (client/.env.production or Vercel Environment Variables)
# Set VITE_API_BASE_URL on Vercel to your Render backend URL (no trailing slash):
# VITE_API_BASE_URL=https://chatterbox-main.onrender.com
